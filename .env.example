# ── Naver OpenAPI (검색/쇼핑 + 데이터랩) ──
# https://developers.naver.com → Application 등록 → "검색" + "데이터랩(검색어트렌드)" API
NAVER_CLIENT_ID=your_client_id
NAVER_CLIENT_SECRET=your_client_secret

# ── 한국은행 ECOS (환율, F12) ──
# https://ecos.bok.or.kr/api 에서 무료 발급
ECOS_API_KEY=your_ecos_key

# ── PostgreSQL ──
POSTGRES_USER=price
POSTGRES_PASSWORD=price_pw
POSTGRES_DB=price_dashboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://price:price_pw@localhost:5432/price_dashboard

# ── 수집/집계 설정 ──
ANOMALY_THRESHOLD_PCT=10
COLLECT_DISPLAY=50
